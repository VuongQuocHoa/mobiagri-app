generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model FarmerPlot {
  id          Int      @id @default(autoincrement())
  farmer      Farmer?  @relation(fields: [farmerId], references: [id])
  farmerId    Int?
  season      Season?  @relation(fields: [seasonId], references: [id])
  seasonId    Int?
  name        String
  location    String
  cropType    String
  areaHa      Float
  status      String
  latitude    Float?
  longitude   Float?
  locationSource String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cropLogs    CropLog[]
}

model Farmer {
  id          Int          @id @default(autoincrement())
  name        String
  phone       String       @unique
  address     String
  areaHa      Float
  cropType    String
  status      String       @default("Đang canh tác")
  plots       FarmerPlot[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Season {
  id            Int          @id @default(autoincrement())
  name          String
  cropType      String
  startDate     DateTime
  harvestDate   DateTime
  expectedYield Float
  status        String
  plots         FarmerPlot[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model CropLog {
  id          Int         @id @default(autoincrement())
  plot        FarmerPlot  @relation(fields: [plotId], references: [id])
  plotId      Int
  date        DateTime
  activity    String
  item        String
  quantity    String
  notes       String?
  createdAt   DateTime @default(now())
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("manager")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CommunityPost {
  id          Int            @id @default(autoincrement())
  author      String
  title       String
  content     String
  tags        String
  createdAt   DateTime       @default(now())
  comments    Comment[]
}

model Comment {
  id          Int            @id @default(autoincrement())
  post        CommunityPost  @relation(fields: [postId], references: [id])
  postId      Int
  author      String
  content     String
  createdAt   DateTime       @default(now())
}

model DiseaseResult {
  id          Int      @id @default(autoincrement())
  imageUrl    String?
  cropName    String
  diseaseName String
  confidence  Float
  treatment   String
  advice      String
  createdAt   DateTime @default(now())
}
